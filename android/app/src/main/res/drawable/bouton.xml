<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton du widget : cadre encre, fond carte, petite ombre décalée (comme les boutons du site) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/encre" />
        </shape>
    </item>
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/carte" />
            <stroke android:width="1.5dp" android:color="@color/encre" />
        </shape>
    </item>
</layer-list>
