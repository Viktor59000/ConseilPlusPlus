<?xml version="1.0" encoding="utf-8"?>
<!-- Carte du cabinet : fond papier, bord encre de 2dp, ombre portée décalée -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/encre" />
        </shape>
    </item>
    <item android:bottom="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/carte" />
            <stroke android:width="2dp" android:color="@color/encre" />
        </shape>
    </item>
</layer-list>
