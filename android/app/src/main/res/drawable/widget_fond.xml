<?xml version="1.0" encoding="utf-8"?>
<!-- La copie du cabinet : carte arrondie, filet discret, marge rouge à gauche (comme sur le site) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/carte" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/filet" />
        </shape>
    </item>
    <item android:left="22dp" android:width="2dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/marge" />
        </shape>
    </item>
</layer-list>
